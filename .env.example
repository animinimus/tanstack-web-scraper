# PostgreSQL connection string (Prisma + runtime).
DATABASE_URL=postgresql://user:password@localhost:5432/recall

# Secret for signing better-auth session cookies (32+ random characters).
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public URL of the app (used for auth callbacks and redirects).
# Local dev default:
BETTER_AUTH_URL=http://localhost:3000

# Firecrawl API key (https://www.firecrawl.dev/).
FIRECRAWL_API_KEY=fc-your-api-key

# Optional: Node environment (development | production | test).
# NODE_ENV=development